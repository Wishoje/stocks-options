APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SCHEDULER_LOG_LEVEL=info
SCHEDULER_LOG_DAYS=30
QUEUE_MONITOR_LOG_LEVEL=info
QUEUE_MONITOR_LOG_DAYS=30
EOD_REPAIR_LOG_LEVEL=info
EOD_REPAIR_LOG_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gex_profile
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_LONG_CONNECTION=database-long
QUEUE_LONG_QUEUE=exports
DB_QUEUE_RETRY_AFTER=1080
DB_LONG_QUEUE_RETRY_AFTER=1080
REDIS_QUEUE_RETRY_AFTER=1080
REDIS_LONG_QUEUE_RETRY_AFTER=1080
QUEUE_MONITOR_ENABLED=true
QUEUE_MONITOR_CONNECTION=database
QUEUE_MONITOR_QUEUES=bootstrap,bootstrap-fast,prime,default,intraday-interactive,intraday,intraday-heavy,calculator,calculator-interactive,calculator-fill,calculator-fill-heavy,quotes,exports
QUEUE_MONITOR_TARGETS=
QUEUE_MONITOR_MAX_SIZE=250

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_CALCULATOR_STATUS_MAX_REQUESTS=50

MASSIVE_API_KEY=
MASSIVE_BASE=https://api.massive.com
MASSIVE_AUTH_MODE=header
MASSIVE_API_HEADER=X-API-Key
MASSIVE_API_QUERY=apiKey
MASSIVE_CONCURRENCY_ENABLED=false
MASSIVE_CONCURRENCY_CONNECTION=default
MASSIVE_CONCURRENCY_KEY=provider-concurrency:massive
MASSIVE_CONCURRENCY_LIMIT=
MASSIVE_CONCURRENCY_RELEASE_AFTER=90
MASSIVE_CONCURRENCY_BLOCK_FOR=45
MASSIVE_CONCURRENCY_WEB_BLOCK_FOR=2
MASSIVE_CONCURRENCY_SLEEP_MS=100
MASSIVE_CONCURRENCY_METRICS_TTL=172800

# Enable only after all isolated Forge consumers exist. The provider limiter
# must be enabled first; otherwise isolated queue resolution fails closed.
QUEUE_LANES_ISOLATED=false
INTRADAY_HEAVY_SYMBOLS=SPY,QQQ
CALCULATOR_HEAVY_SYMBOLS=SPY,QQQ,IWM

CALC_CHAIN_MAX_PAGES=150
CALC_CHAIN_MAX_PAGES_LARGE=350
CALCULATOR_QUOTE_EXTENDED_START=04:00
CALCULATOR_QUOTE_EXTENDED_END=20:00
CALCULATOR_QUOTE_REGULAR_LIVE_SECONDS=600
CALCULATOR_QUOTE_REGULAR_USABLE_SECONDS=3600
CALCULATOR_QUOTE_EXTENDED_LIVE_SECONDS=1800
CALCULATOR_QUOTE_EXTENDED_USABLE_SECONDS=43200
CALCULATOR_QUOTE_CLOSED_LIVE_SECONDS=0
CALCULATOR_QUOTE_CLOSED_USABLE_SECONDS=259200
CALCULATOR_QUOTE_ALLOW_STALE=true
CALCULATOR_QUOTE_FUTURE_TOLERANCE_SECONDS=30
CALCULATOR_SCHEDULER_MAX_SYMBOLS=75
CALCULATOR_SCHEDULER_FRESH_MINUTES=10
CALCULATOR_SCHEDULER_INTERVAL_MINUTES=5
CALCULATOR_SCHEDULER_PENDING_TTL=43200
CALCULATOR_SCHEDULER_STARTED_TTL=3600
CALCULATOR_SCHEDULER_FAILURE_COOLDOWN=300
CALCULATOR_SCHEDULER_FAILURE_COOLDOWN_MAX=3600
CALCULATOR_SCHEDULER_STATE_TTL=2592000
CALCULATOR_SCHEDULER_FALLBACK_SYMBOLS=SPY,QQQ,IWM

# Durable API work intents. The request cap is above the largest authorized
# production watchlist measured for GEX-011 (80 symbols); inputs are rejected,
# never truncated. Start limits are an admission budget for new durable scopes;
# the provider concurrency gate remains the hard in-flight request bound.
WORK_RUN_MAX_SYMBOLS_PER_REQUEST=250
WORK_RUN_PENDING_TTL=43200
WORK_RUN_CALCULATOR_RUNNING_TTL=3600
WORK_RUN_INTRADAY_RUNNING_TTL=1800
WORK_RUN_BOOTSTRAP_RUNNING_TTL=10800
WORK_RUN_CALCULATOR_REUSE=600
WORK_RUN_INTRADAY_REUSE=90
WORK_RUN_BOOTSTRAP_REUSE=600
WORK_RUN_FAILURE_COOLDOWN=300
WORK_RUN_DISPATCH_RETRY=15
WORK_RUN_DISPATCH_RESERVATION=120
WORK_RUN_ABANDON_AFTER=86400
WORK_RUN_STATUS_POLL_SECONDS=2
WORK_RUN_USER_RATE_LIMIT=120
WORK_RUN_IP_RATE_LIMIT=240
WORK_RUN_SYMBOL_START_LIMIT=12
WORK_RUN_PROVIDER_START_LIMIT=120
WORK_RUN_STATUS_RATE_LIMIT=180
EOD_CHAIN_MAX_PAGES=120
EOD_CHAIN_PAGE_LIMIT=250
EOD_CHAIN_MAX_PAGES_PER_EXPIRY=80
EOD_CHAIN_PARTITIONED_FETCH_ENABLED=false
EOD_CHAIN_PARTITIONED_CANARY_SYMBOLS=
EOD_CHAIN_MAX_PAGES_PER_PARTITION=40
EOD_CHAIN_REFERENCE_PROBE_MAX_PAGES=4
EOD_CHAIN_MAX_HINT_EXPIRIES=90
EOD_CHAIN_REFERENCE_MAX_PAGES=40
EOD_CHAIN_REPAIR_PARTIAL_EXPIRIES=true
EOD_STRIKE_BAND_PCT=2.0
EOD_GREEKS_NEAR_PCT=2.0
EOD_MIN_KEEP_OI=1
EOD_MIN_KEEP_VOL=1
